#!/bin/bash -l
# Four optimizer agents on one Polaris node, one A100 each (4_gino_optimizer_board.py):
# per round they debate which optimizers are feasible, claim one each, train, and report back.
#
# Submit from the repo root (the job cds to $PBS_O_WORKDIR):
#   qsub -A <project> scaling_agents/polaris_gino_optimizer.pbs
#   qsub -A <project> -v ROUNDS=4,RUNS_PER_ROUND=3 scaling_agents/polaris_gino_optimizer.pbs
#
# Two environments: the agents run in this repo's uv .venv (VENV); training runs through
# polaris_train_python.sh (TRAIN_PYTHON), which loads ALCF conda + aifiv/aifiv_env (AIFIV_ENV).
# The agents use GINO_LLM_MODEL (default claude-opus-5-5), falling back to GINO_LLM_FALLBACK_MODEL
# (default claude-sonnet-5-5) when it is overloaded.
#
# Walltime: about ROUNDS x RUNS_PER_ROUND x RUN_TIMEOUT_MIN plus debate time (3 x 2 x 60 min + ~1 h).
#
# Or interactively: qsub -I -A <project> -q debug -l select=1 -l walltime=01:00:00 -l filesystems=home:eagle,
# then run the commands below by hand.
#PBS -N gino_optimizer
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=08:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "$0")/..}"
REPO=$(pwd)

# Agents: the uv env (academy, claude-agent-sdk) and the LLM gateway + proxy settings.
VENV=${VENV:-$REPO/.venv}
[ -d "$VENV" ] || VENV=$HOME/.venv
source "$VENV/bin/activate"
source "$REPO/aurora_env_setup.sh"

# Training: ALCF conda torch + torch_geometric, loaded only in the training subprocesses.
TRAIN_PYTHON=${TRAIN_PYTHON:-$REPO/scaling_agents/polaris_train_python.sh}
# Fail in seconds, not in round 1, if the training env is broken.
"$TRAIN_PYTHON" -c "
import torch, numpy, scipy, yaml, netCDF4
from torch_geometric.nn import radius
assert torch.cuda.device_count() >= 4, torch.cuda.device_count()
x = torch.rand(100, 2, device='cuda')
print('training env OK:', torch.__version__, torch.version.cuda, torch.cuda.device_count(), 'GPUs', radius(x, x, 0.1).shape)
"

nvidia-smi topo -m || true

python scaling_agents/4_gino_optimizer_board.py \
    --gpus 0 1 2 3 \
    --train-python "$TRAIN_PYTHON" \
    --fixed-args "${FIXED_ARGS:---epochs 2000 --warmup-epochs 200 --ramp-epochs 800}" \
    --rounds "${ROUNDS:-3}" \
    --runs-per-round "${RUNS_PER_ROUND:-2}" \
    --run-timeout-min "${RUN_TIMEOUT_MIN:-60}" \
    ${CAMPAIGN:+--campaign "$CAMPAIGN"}
